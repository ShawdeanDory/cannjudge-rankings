{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cannjudge-rankings-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "RANKING_STORE", "class_name": "RankingStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RankingStore"] }]
}
